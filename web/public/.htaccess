Options -Indexes
DirectoryIndex seo.php index.html
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule ^robots\.txt$ seo.php?mode=robots [L]
 RewriteRule ^(productos|zocalos)/?$ accesorios [R=301,L]
 RewriteRule ^sitemap\.xml$ seo.php?mode=sitemap [L]
 RewriteRule ^(pisos|accesorios|blog|proyectos)/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ seo.php?kind=$1&slug=$2 [L]
 RewriteCond %{REQUEST_FILENAME} -f [OR]
 RewriteCond %{REQUEST_FILENAME} -d
 RewriteRule ^ - [L]
 RewriteRule ^(pisos|accesorios|blog|proyectos|nosotros|contacto|piso-laminado)/?$ seo.php?page=$1 [L]
 RewriteRule ^$ seo.php?page=/ [L]
 RewriteRule ^ seo.php [L]
</IfModule>
